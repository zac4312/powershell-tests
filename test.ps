# Prompt for credentials once at startup
Write-Host "Please enter Domain Admin Credentials:" -ForegroundColor Yellow
$globalCreds = Get-Credential

do {
    Clear-Host
    Write-Host "==========================================" -ForegroundColor Cyan
    Write-Host "     ENTERPRISE ACTIVE DIRECTORY ADMIN     " -ForegroundColor Yellow
    Write-Host "==========================================" -ForegroundColor Cyan
    Write-Host " [1] Select Target Client PC & Run Actions"
    Write-Host " [2] View All Domain Computers"
    Write-Host " [3] View All Domain Users"
    Write-Host " [4] Exit"
    Write-Host "==========================================" -ForegroundColor Cyan
    
    $mainChoice = Read-Host "Select an option (1-4)"

    if ($mainChoice -eq '4') { break }

    switch ($mainChoice) {
        '1' {
            Clear-Host
            Write-Host "==========================================" -ForegroundColor Cyan
            Write-Host "         ACTIVE DOMAIN COMPUTERS          " -ForegroundColor Yellow
            Write-Host "==========================================" -ForegroundColor Cyan
            
            # Fetch computers cleanly, excluding the server itself if desired
            $computerObjects = Get-ADComputer -Filter * -Properties Name | Select-Object -ExpandProperty Name
            
            if (-not $computerObjects) {
                Write-Host "`n[!] No domain computers found!" -ForegroundColor Red
                Start-Sleep -Seconds 2
                continue
            }

            # Ensure it's treated as an array
            $computers = @($computerObjects)

            for ($i = 0; $i -lt $computers.Count; $i++) {
                Write-Host " [$($i + 1)] $($computers[$i])"
            }
            Write-Host " [0] Back to Main Menu"
            Write-Host "==========================================" -ForegroundColor Cyan

            $targetIndex = (Read-Host "Select target computer number").Trim()
            
            if ($targetIndex -eq '0' -or [string]::IsNullOrWhiteSpace($targetIndex)) {
                continue
            }

            $selectedNumber = 0
            if (-not [int]::TryParse($targetIndex, [ref]$selectedNumber) -or
                $selectedNumber -lt 1 -or $selectedNumber -gt $computers.Count) {
                Write-Host "`n[!] Invalid selection index." -ForegroundColor Red
                Start-Sleep -Seconds 2
                continue
            }

            $idx = $selectedNumber - 1
            $selectedPC = $computers[$idx]
            Write-Host "`n[+] Target locked: $selectedPC" -ForegroundColor Green
            Start-Sleep -Seconds 1

            do {
                Clear-Host
                Write-Host "==========================================" -ForegroundColor Cyan
                Write-Host "   TARGET: $selectedPC" -ForegroundColor Yellow
                Write-Host "==========================================" -ForegroundColor Cyan
                Write-Host " [1] Check Active Processes"
                Write-Host " [2] Check Uptime & Last Boot"
                Write-Host " [3] View Recent Failed Logons (Event 4625)"
                Write-Host " [4] Check Local Disk Space"
                Write-Host " [5] Back to Main Menu"
                Write-Host "==========================================" -ForegroundColor Cyan

                $actionChoice = Read-Host "Select an action (1-5)"

                if ($actionChoice -eq '5') { break }

                switch ($actionChoice) {
                    '1' {
                        Write-Host "`n[+] Fetching Remote Task Manager processes from $selectedPC..." -ForegroundColor Green
                        try {
                            Invoke-Command -ComputerName $selectedPC -Credential $globalCreds -ScriptBlock {
                                Get-Process | Sort-Object WorkingSet -Descending | Select-Object Id, ProcessName, @{Name="Memory(MB)";Expression={="{0:N2}" -f ($_.WorkingSet / 1MB)}}, CPU | Select-Object -First 15
                            }
                            
                            Write-Host "`n------------------------------------------" -ForegroundColor Cyan
                            $killChoice = Read-Host "Enter a Process ID (PID) to kill (or press Enter to skip)"
                            
                            if (-not [string]::IsNullOrWhiteSpace($killChoice)) {
                                $targetPid = [int]$killChoice
                                Write-Host "[+] Attempting to terminate PID $targetPid on$selectedPC..." -ForegroundColor Yellow
st                               
                                Invoke-Command -ComputerName $selectedPC -Credential $globalCreds -ScriptBlock {
                                    param($pidToKill)
                                    Stop-Process -Id $pidToKill -Force -ErrorAction Stop
                                    Write-Host "[+] Successfully killed process ID $pidToKill." -ForegroundColor Green
                                } -ArgumentList $targetPid
                            }
                        } catch {
                            Write-Host "[!] Error managing remote processes: $_" -ForegroundColor Red
                        }
                    }
                    '2' {
                        Write-Host "`n[+] Checking uptime for $selectedPC..." -ForegroundColor Green
                        try {
                            Invoke-Command -ComputerName $selectedPC -Credential $globalCreds -ScriptBlock {$os = Get-CimInstance Win32_OperatingSystem
                                $uptime = (Get-Date) -$os.LastBootUpTime
                                [PSCustomObject]@{
                                    ComputerName  = $env:COMPUTERNAME
                                    LastBootTime  = $os.LastBootUpTime
                                    UptimeDays    = $uptime.Days
                                    UptimeHours   = $uptime.Hours
                                    UptimeMinutes = $uptime.Minutes
                                }
                            }
                        } catch {
                            Write-Host "[!] Error fetching uptime." -ForegroundColor Red
                        }
                    }
                    '3' {
                        Write-Host "`n[+] Fetching recent failed logons from $selectedPC..." -ForegroundColor Green
                        try {
                            Get-WinEvent -ComputerName $selectedPC -Credential $globalCreds -FilterHashtable @{LogName='Security'; ID=4625} -MaxEvents 5 |
                                Select-Object TimeCreated, Message
                        } catch {
                            Write-Host "[!] Error fetching failed logons: $_" -ForegroundColor Red
                        }
                    }
                    '4' {
                        Write-Host "`n[+] Checking local disk space on $selectedPC..." -ForegroundColor Green
                        try {
                            Get-CimInstance -ComputerName $selectedPC -ClassName Win32_LogicalDisk -Filter "DriveType=3" |
                                Select-Object DeviceID,
                                    @{Name="FreeSpace(GB)";Expression={"{0:N2}" -f ($_.FreeSpace / 1GB)}},
                                    @{Name="TotalSize(GB)";Expression={"{0:N2}" -f ($_.Size / 1GB)}}
                        } catch {
                            Write-Host "[!] Error fetching disk space: $_" -ForegroundColor Red
                        }
                    }
                    default { Write-Host "`n[!] Invalid selection." -ForegroundColor Red }
                }

                Write-Host "`nPress any key to return to target menu..." -ForegroundColor DarkGray
                $null =$Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")

            } while ($actionChoice -ne '5')
        }
        '2' {
            Clear-Host
            Write-Host "`n[+] Querying Active Directory Domain Computers..." -ForegroundColor Green
            Get-ADComputer -Filter * -Properties Name, OperatingSystem, Enabled | Select-Object Name, OperatingSystem, Enabled
            Write-Host "`nPress any key to return to main menu..." -ForegroundColor DarkGray
            $null =$Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
        }
        '3' {
            Clear-Host
            Write-Host "`n[+] Querying Active Directory Domain Users..." -ForegroundColor Green
            Get-ADUser -Filter * -Properties Enabled, LastLogonDate |
                Select-Object Name, SamAccountName, Enabled, LastLogonDate
            Write-Host "`nPress any key to return to main menu..." -ForegroundColor DarkGray
            $null =$Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
        }
        default {
            Write-Host "`n[!] Invalid selection." -ForegroundColor Red
            Start-Sleep -Seconds 1
        }
    }

} while ($true)

Write-Host "`nExiting Admin Console. Goodbye!" -ForegroundColor Yellow
