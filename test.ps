# Admin Command Center Menu Loop
do {
    Clear-Host
    Write-Host "==========================================" -ForegroundColor Cyan
    Write-Host "     ENTERPRISE ACTIVE DIRECTORY ADMIN     " -ForegroundColor Yellow
    Write-Host "==========================================" -ForegroundColor Cyan
    Write-Host " [1] Launch Notepad on User PC (Remote GUI)"
    Write-Host " [2] Check Active Processes on User PC"
    Write-Host " [3] Check User Uptime & Last Boot"
    Write-Host " [4] Check Domain Computers & Status"
    Write-Host " [5] Exit"
    Write-Host "==========================================" -ForegroundColor Cyan
    
    $choice = Read-Host "Select an action (1-5)"

    switch ($choice) {
        '1' {
            Write-Host "`n[+] Sending command to launch Notepad on client..." -ForegroundColor Green
            Invoke-Command -ComputerName tiny11_usr1 -Credential (Get-Credential) -ScriptBlock {
                $process = Start-Process notepad.exe -PassThru
                Start-Sleep -Milliseconds 500
                Add-Type -AssemblyName System.Windows.Forms
                [System.Windows.Forms.SendKeys]::SendWait("Hello from the Domain Admin!")
                [System.Windows.Forms.SendKeys]::SendWait("{ENTER}")
            }
            Write-Host "`n[+] Action completed." -ForegroundColor Green
        }
        '2' {
            Write-Host "`n[+] Fetching active processes from User PC..." -ForegroundColor Green
            Invoke-Command -ComputerName tiny11_usr1 -Credential (Get-Credential) -ScriptBlock {
                Get-Process | Where-Object {$_.MainWindowTitle -ne ""} | Select-Object ProcessName, MainWindowTitle, StartTime
            }
        }
        '3' {
            Write-Host "`n[+] Checking system uptime and last boot time for User PC..." -ForegroundColor Green
            Invoke-Command -ComputerName tiny11_usr1 -Credential (Get-Credential) -ScriptBlock {
                $os = Get-CimInstance Win32_OperatingSystem
                $uptime = (Get-Date) -$os.LastBootUpTime
                [PSCustomObject]@{
                    ComputerName  = $env:COMPUTERNAME
                    LastBootTime  = $os.LastBootUpTime
                    UptimeDays    = $uptime.Days
                    UptimeHours   = $uptime.Hours
                    UptimeMinutes = $uptime.Minutes
                }
            }
        }
        '4' {
            Write-Host "`n[+] Querying Active Directory Domain Computers..." -ForegroundColor Green
            Get-ADComputer -Filter * -Properties Name, OperatingSystem, Enabled | Select-Object Name, OperatingSystem, Enabled
        }
        '5' {
            Write-Host "`nExiting Admin Console. Goodbye!" -ForegroundColor Yellow
            break
        }
        default {
            Write-Host "`n[!] Invalid selection. Please choose between 1 and 5." -ForegroundColor Red
        }
    }

    if ($choice -ne '5') {
        Write-Host "`nPress any key to return to the menu..." -ForegroundColor DarkGray
        $null =$Host.UI.RawUI.ReadKey("NoEcho,IncludeKeyDown")
    }

} while ($choice -ne '5')
